<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:jboss:domain:mcp:experimental:2.0"
           xmlns="urn:jboss:domain:mcp:experimental:2.0"
           xmlns:credential-reference="urn:wildfly:credential-reference:1.1"
           elementFormDefault="qualified"
           version="2.0">
    <xs:import namespace="urn:wildfly:credential-reference:1.1" schemaLocation="https://www.jboss.org/schema/jbossas/wildfly-credential-reference_1_1.xsd"/>
    <xs:element name="subsystem" type="subsystemType">
        <xs:annotation>
            <xs:documentation>
                The MCP subsystem root element.
            </xs:documentation>
        </xs:annotation>
    </xs:element>

    <xs:complexType name="subsystemType">
        <xs:annotation>
            <xs:documentation>
                The MCP subsystem root type.
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="credential-reference" type="credential-reference:credentialReferenceType" minOccurs="0" maxOccurs="1">
                <xs:annotation>
                    <xs:documentation>
                        Credential (holding a secret key) used to sign and verify requestState tokens for multi-round
                        tool results. When set, the server signs opaque state that clients echo back across
                        stateless requests.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
        <xs:attribute name="sse-path" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>
                    The sse path on the server.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="messages-path" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>
                    The messages path on the server.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="streamable-path" type="xs:string" use="required">
            <xs:annotation>
                <xs:documentation>
                    The streamable path on the server.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="page-size" type="xs:int">
            <xs:annotation>
                <xs:documentation>
                    Maximum number of items per paginated list response. A value of 0 disables pagination.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="timeout" type="xs:long">
            <xs:annotation>
                <xs:documentation>
                    Idle connection timeout in seconds. Connections inactive for longer than this will be closed.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="request-timeout" type="xs:long">
            <xs:annotation>
                <xs:documentation>
                    Maximum time in seconds to wait for a single request (e.g. tool call) to complete before returning a timeout error. Defaults to 300 (5 minutes).
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="allowed-origins" type="xs:string">
            <xs:annotation>
                <xs:documentation>
                    Space-separated list of additional hostnames accepted by DNS-rebinding validation. Localhost is always allowed.
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="cache-ttl" type="xs:long">
            <xs:annotation>
                <xs:documentation>
                    Default cache TTL in milliseconds for list and discover responses. Defaults to 3600000 (1 hour).
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="cache-scope" type="xs:string">
            <xs:annotation>
                <xs:documentation>
                    Default cache scope for list and discover responses. Valid values are "public" and "private". Defaults to "public".
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>
</xs:schema>
